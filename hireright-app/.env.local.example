# ── Hireright environment configuration ───────────────────────────────
# Copy this file to `.env.local` and fill in values to enable real integrations.
# The app runs fully without any of these (mocked AI + folder ingestion).

# ── AI provider ───────────────────────────────────────────────────────
# Leave as "mock" (or unset) for the built-in deterministic mock AI (default).
# Set to "anthropic" AND provide a key to use real Claude (claude-opus-5).
# The mock stays as an automatic per-call fallback if the API errors.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────────────────────────
# Unset  → file store at .data/db.json (zero-config default).
# Set    → PostgreSQL (schema auto-migrates + seeds on first use).
# Works with local Postgres, Neon, Supabase, RDS, etc. Remote hosts use SSL.
# DATABASE_URL=postgres://user:pass@host:5432/hireright

# ── ATS connectors (NOT enabled in this build — folder ingestion is live) ──
# GREENHOUSE_API_KEY=
# LEVER_API_KEY=
# ASHBY_API_KEY=

# ── LinkedIn (coming soon — no direct API; requires partner/aggregator) ──
# LINKEDIN_AGGREGATOR_API_KEY=
